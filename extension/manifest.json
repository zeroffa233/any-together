{
  "manifest_version": 3,
  "name": "AnyTogether 播放同步客户端",
  "version": "0.1.0",
  "description": "连接 any-together Node 伴随进程，在 Bilibili 从机页面执行权威播放状态。",
  "permissions": ["scripting"],
  "optional_host_permissions": ["http://*/*"],
  "host_permissions": [
    "https://bilibili.com/video/*",
    "https://*.bilibili.com/video/*",
    "https://youtube.com/watch*",
    "https://*.youtube.com/watch*",
    "https://missav.live/*/*",
    "https://*.missav.live/*/*",
    "https://pornhub.com/view_video.php*",
    "https://*.pornhub.com/view_video.php*",
    "https://xvideos.com/video.*/*",
    "https://*.xvideos.com/video.*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AnyTogether 播放同步",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bilibili.com/video/*",
        "https://*.bilibili.com/video/*",
        "https://youtube.com/watch*",
        "https://*.youtube.com/watch*",
        "https://missav.live/*/*",
        "https://*.missav.live/*/*",
        "https://pornhub.com/view_video.php*",
        "https://*.pornhub.com/view_video.php*",
        "https://xvideos.com/video.*/*",
        "https://*.xvideos.com/video.*/*"
      ],
      "js": ["identity.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
